<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:EnvironmentalApp"
             xmlns:data="clr-namespace:EnvironmentalApp.Data"
             x:Class="EnvironmentalApp.DataAnalysisPage"
             Title="Historical Data Analysis">

    <Grid RowDefinitions="Auto, Auto, Auto, *" Padding="10" RowSpacing="10">

        <!-- Controls -->
        <VerticalStackLayout Grid.Row="0" Spacing="5">
            <Label Text="Select Data Type:"/>
            <Picker x:Name="DataTypePicker" SelectedIndexChanged="DataTypePicker_SelectedIndexChanged">
                <Picker.ItemsSource>
                    <x:Array Type="{x:Type x:String}">
                        <x:String>Air Quality</x:String>
                        <x:String>Water Quality</x:String>
                        <x:String>Weather</x:String>
                    </x:Array>
                </Picker.ItemsSource>
            </Picker>

            <HorizontalStackLayout Spacing="10">
                <VerticalStackLayout>
                    <Label Text="Start Date:"/>
                    <DatePicker x:Name="StartDatePicker" Date="2025-02-01"/>
                    <!-- Set initial date based on sample data -->
                </VerticalStackLayout>
                <VerticalStackLayout>
                    <Label Text="End Date:"/>
                    <DatePicker x:Name="EndDatePicker" Date="2025-02-07"/>
                    <!-- Set initial date based on sample data -->
                </VerticalStackLayout>
            </HorizontalStackLayout>

            <Button Text="Load Historical Data" Clicked="LoadDataButton_Clicked"/>
        </VerticalStackLayout>

        <!-- Loading Indicator -->
        <ActivityIndicator Grid.Row="1" x:Name="LoadingIndicator" IsRunning="False" IsVisible="False" Color="{StaticResource Primary}"/>

        <!-- Data Grids (only one visible at a time) -->
        <!-- Air Quality Grid -->
        <Grid Grid.Row="2" RowDefinitions="Auto, *" x:Name="AirQualityGrid" IsVisible="False">
            <Grid Grid.Row="0" BackgroundColor="{StaticResource Gray100}" Padding="5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Label Grid.Column="0" Text="Timestamp" FontAttributes="Bold"/>
                <Label Grid.Column="1" Text="NO2 (µg/m³)" FontAttributes="Bold"/>
                <Label Grid.Column="2" Text="SO2 (µg/m³)" FontAttributes="Bold"/>
                <Label Grid.Column="3" Text="PM2.5 (µg/m³)" FontAttributes="Bold"/>
                <Label Grid.Column="4" Text="PM10 (µg/m³)" FontAttributes="Bold"/>
            </Grid>
            <CollectionView Grid.Row="1" x:Name="AirQualityCollectionView">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="data:AirQualityReading">
                        <Grid Padding="5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Label Grid.Column="0" Text="{Binding Timestamp, StringFormat='{0:yyyy-MM-dd HH:mm}'}" FontSize="Small"/>
                            <Label Grid.Column="1" Text="{Binding NitrogenDioxide, StringFormat='{0:N2}'}" FontSize="Small"/>
                            <Label Grid.Column="2" Text="{Binding SulphurDioxide, StringFormat='{0:N2}'}" FontSize="Small"/>
                            <Label Grid.Column="3" Text="{Binding PM25, StringFormat='{0:N2}'}" FontSize="Small"/>
                            <Label Grid.Column="4" Text="{Binding PM10, StringFormat='{0:N1}'}" FontSize="Small"/>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>

        <!-- Water Quality Grid -->
        <Grid Grid.Row="2" RowDefinitions="Auto, *" x:Name="WaterQualityGrid" IsVisible="False">
            <Grid Grid.Row="0" BackgroundColor="{StaticResource Gray100}" Padding="5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Label Grid.Column="0" Text="Timestamp" FontAttributes="Bold"/>
                <Label Grid.Column="1" Text="Nitrate (mg/l)" FontAttributes="Bold"/>
                <Label Grid.Column="2" Text="Nitrite (mg/l)" FontAttributes="Bold"/>
                <Label Grid.Column="3" Text="Phosphate (mg/l)" FontAttributes="Bold"/>
                <Label Grid.Column="4" Text="EC (cfu/100ml)" FontAttributes="Bold"/>
            </Grid>
            <CollectionView Grid.Row="1" x:Name="WaterQualityCollectionView">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="data:WaterQualityReading">
                        <Grid Padding="5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Label Grid.Column="0" Text="{Binding Timestamp, StringFormat='{0:yyyy-MM-dd HH:mm}'}" FontSize="Small"/>
                            <Label Grid.Column="1" Text="{Binding Nitrate, StringFormat='{0:N2}'}" FontSize="Small"/>
                            <Label Grid.Column="2" Text="{Binding Nitrite, StringFormat='{0:N2}'}" FontSize="Small"/>
                            <Label Grid.Column="3" Text="{Binding Phosphate, StringFormat='{0:N2}'}" FontSize="Small"/>
                            <Label Grid.Column="4" Text="{Binding EC, StringFormat='{0:N0}', TargetNullValue='N/A'}" FontSize="Small"/>
                            <!-- EC might be null for hourly -->
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>

        <!-- Weather Grid -->
        <Grid Grid.Row="2" RowDefinitions="Auto, *" x:Name="WeatherGrid" IsVisible="False">
            <Grid Grid.Row="0" BackgroundColor="{StaticResource Gray100}" Padding="5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Label Grid.Column="0" Text="Timestamp" FontAttributes="Bold"/>
                <Label Grid.Column="1" Text="Temp (°C)" FontAttributes="Bold"/>
                <Label Grid.Column="2" Text="Humidity (%)" FontAttributes="Bold"/>
                <Label Grid.Column="3" Text="Wind Spd (m/s)" FontAttributes="Bold"/>
                <Label Grid.Column="4" Text="Wind Dir (°)" FontAttributes="Bold"/>
            </Grid>
            <CollectionView Grid.Row="1" x:Name="WeatherCollectionView">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="data:WeatherReading">
                        <Grid Padding="5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Label Grid.Column="0" Text="{Binding Timestamp, StringFormat='{0:yyyy-MM-dd HH:mm}'}" FontSize="Small"/>
                            <Label Grid.Column="1" Text="{Binding Temperature, StringFormat='{0:N1}'}" FontSize="Small"/>
                            <Label Grid.Column="2" Text="{Binding Humidity, StringFormat='{0:N0}'}" FontSize="Small"/>
                            <Label Grid.Column="3" Text="{Binding WindSpeed, StringFormat='{0:N2}'}" FontSize="Small"/>
                            <Label Grid.Column="4" Text="{Binding WindDirection, StringFormat='{0:N0}'}" FontSize="Small"/>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>

        <Label Grid.Row="3" x:Name="StatusLabel" Text="Select data type and date range, then load data." HorizontalOptions="Center" VerticalOptions="Center"/>

    </Grid>
</ContentPage>