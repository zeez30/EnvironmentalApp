<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodel="clr-namespace:EnvironmentalApp.ViewModels"
             x:Class="EnvironmentalApp.MainPage"
             x:DataType="viewmodel:MainPageViewModel">

    <ScrollView>
        <VerticalStackLayout Padding="20">

            <Label Text="Environmental Monitoring App" FontSize="Title" HorizontalOptions="Center" />

            <Grid ColumnDefinitions="*, *" RowDefinitions="Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto">

                <Button Text="View Map" Clicked="OnMapViewClicked" Grid.Row="0" Grid.ColumnSpan="2"/>

                <Label Text="Recent Alerts:" FontSize="Subtitle" Grid.Row="1" Grid.ColumnSpan="2"/>

                <CollectionView ItemsSource="{Binding RecentAlerts}" Grid.Row="2" Grid.ColumnSpan="2">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="*, Auto">
                                <Label Text="{Binding AlertMessage}" Grid.Column="0" />
                                <Label Text="{Binding AlertTime}" Grid.Column="1" />
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <Label Text="Sensor Status:" FontSize="Subtitle" Grid.Row="3" Grid.ColumnSpan="2"/>

                <CollectionView ItemsSource="{Binding Sensors}" Grid.Row="4" Grid.ColumnSpan="2">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="*, *, *, *, *">
                                <Label Text="{Binding Name}" Grid.Column="0"/>
                                <Label Text="{Binding OperationalStatus}" Grid.Column="1"/>
                                <Label Text="{Binding SensorType}" Grid.Column="2"/>
                                <Label Text="{Binding Latitude}" Grid.Column="3"/>
                                <Label Text="{Binding Longitude}" Grid.Column="4"/>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <Label Text="Air Quality Data:" FontSize="Subtitle" Grid.Row="5" Grid.ColumnSpan="2" />

                <CollectionView ItemsSource="{Binding AirQualityData}" Grid.Row="6" Grid.ColumnSpan="2">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="*, *, *, *, *">
                                <Label Text="{Binding DateTime}" Grid.Column="0" />
                                <Label Text="{Binding NitrogenDioxide}" Grid.Column="1" />
                                <Label Text="{Binding SulphurDioxide}" Grid.Column="2" />
                                <Label Text="{Binding PM2_5}" Grid.Column="3" />
                                <Label Text="{Binding PM10}" Grid.Column="4" />
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <Button Text="Sensor Management" Clicked="OnSensorManagementClicked" Grid.Row="7" Grid.Column="0"/>
                <Button Text="Data Analysis" Clicked="OnDataAnalysisClicked" Grid.Row="7" Grid.Column="1"/>
                <Button Text="Reports" Clicked="OnReportsClicked" Grid.Row="8" Grid.Column="0"/>
                <Button Text="User Management" Clicked="OnUserManagementClicked" Grid.Row="8" Grid.Column="1"/>

                <!-- Button to trigger data import -->
                <Button Text="Import Excel Data" Command="{Binding ImportDataCommand}" Grid.Row="9" Grid.ColumnSpan="2" />

            </Grid>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>