<?xml version="1.0" encoding="utf-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:EnvironmentalApp"
             xmlns:data="clr-namespace:EnvironmentalApp.Data"
             xmlns:converters="clr-namespace:EnvironmentalApp.Converters"
             x:Class="EnvironmentalApp.SensorManagementPage"
             Title="Sensor Management">

    <ContentPage.Resources>
        <!-- Define Converters -->
        <converters:BoolToStringConverter x:Key="BoolToYesNoConverter" TrueString="Yes" FalseString="No" />
        <converters:NullToBoolConverter x:Key="NullToBoolConverter" />
        <!-- Reuse from previous step -->
        <converters:ComparisonConverter x:Key="FirmwareUpdateNeededConverter" Operation="NotEquals"/>
        <converters:FirmwareStatusToColorConverter x:Key="FirmwareStatusColorConv"/>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto, *">
        <Label Text="Sensor List and Maintenance / Configuration" FontSize="Large" Padding="10" Grid.Row="0"/>

        <CollectionView x:Name="SensorsCollectionView"
                        ItemsSource="{Binding Sensors}"
                        Grid.Row="1">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="data:Sensor">
                    <Border StrokeShape="RoundRectangle 5" Stroke="LightGray" StrokeThickness="1" Padding="10" Margin="5">
                        <VerticalStackLayout Spacing="5">
                            <Label Text="{Binding Name}" FontAttributes="Bold" FontSize="Medium" />
                            <Grid ColumnDefinitions="Auto, *" RowDefinitions="Auto, Auto, Auto, Auto, Auto, Auto, *" ColumnSpacing="10">

                                <!-- Basic & Maintenance Info (Rows 0-5 as before) -->
                                <Label Text="Type:" Grid.Row="0" Grid.Column="0" FontAttributes="Bold"/>
                                <Label Text="{Binding Type}" Grid.Row="0" Grid.Column="1" />
                                <Label Text="Status:" Grid.Row="1" Grid.Column="0" FontAttributes="Bold"/>
                                <Label Text="{Binding Status}" Grid.Row="1" Grid.Column="1"/>
                                <Label Text="Last Reading:" Grid.Row="2" Grid.Column="0" FontAttributes="Bold"/>
                                <Label Text="{Binding LastReadingTimestamp, StringFormat='{0:yyyy-MM-dd HH:mm}'}" Grid.Row="2" Grid.Column="1" />
                                <Label Text="Last Maint.:" Grid.Row="3" Grid.Column="0" FontAttributes="Bold"/>
                                <Label Text="{Binding LastMaintenanceDate, StringFormat='{0:yyyy-MM-dd}', TargetNullValue='N/A'}" Grid.Row="3" Grid.Column="1" />
                                <Label Text="Next Maint.:" Grid.Row="4" Grid.Column="0" FontAttributes="Bold"/>
                                <Label Text="{Binding NextMaintenanceDate, StringFormat='{0:yyyy-MM-dd}', TargetNullValue='Not Scheduled'}" Grid.Row="4" Grid.Column="1"/>
                                <Label Text="Maint. Notes:" Grid.Row="5" Grid.Column="0" FontAttributes="Bold" IsVisible="{Binding MaintenanceNotes, Converter={StaticResource StringToBoolConverter}}"/>
                                <Label Text="{Binding MaintenanceNotes}" Grid.Row="5" Grid.Column="1" IsVisible="{Binding MaintenanceNotes, Converter={StaticResource StringToBoolConverter}}"/>

                                <!-- Admin Only Section -->
                                <VerticalStackLayout Grid.Row="6" Grid.ColumnSpan="2" Margin="0,15,0,0" Spacing="8"
                                                     IsVisible="{Binding Source={RelativeSource AncestorType={x:Type local:SensorManagementPage}}, Path=IsAdminVisible}">

                                    <Label Text="--- Configuration and Firmware (Admin) ---" FontSize="Small" FontAttributes="Italic"/>

                                    <!-- Configuration Details -->
                                    <Grid ColumnDefinitions="Auto, *" RowDefinitions="Auto, Auto, Auto" ColumnSpacing="10">
                                        <Label Grid.Row="0" Grid.Column="0" Text="Enabled:" FontAttributes="Bold"/>
                                        <Label Grid.Row="0" Grid.Column="1" Text="{Binding IsEnabled, Converter={StaticResource BoolToYesNoConverter}}"/>
                                        <Label Grid.Row="1" Grid.Column="0" Text="Interval (s):" FontAttributes="Bold"/>
                                        <Label Grid.Row="1" Grid.Column="1" Text="{Binding SamplingIntervalSeconds}"/>
                                        <Label Grid.Row="2" Grid.Column="0" Text="Threshold:" FontAttributes="Bold"/>
                                        <Label Grid.Row="2" Grid.Column="1" Text="{Binding ReportingThreshold, TargetNullValue='N/A'}"/>
                                    </Grid>

                                    <!-- Firmware Details -->
                                    <Grid ColumnDefinitions="Auto, *" RowDefinitions="Auto, Auto, Auto" ColumnSpacing="10" Margin="0,10,0,0">
                                        <Label Grid.Row="0" Grid.Column="0" Text="Firmware Ver:" FontAttributes="Bold"/>
                                        <Label Grid.Row="0" Grid.Column="1" Text="{Binding CurrentFirmwareVersion}"/>
                                        <Label Grid.Row="1" Grid.Column="0" Text="Latest Ver:" FontAttributes="Bold"/>
                                        <Label Grid.Row="1" Grid.Column="1" Text="{Binding LatestFirmwareVersion}"/>
                                        <Label Grid.Row="2" Grid.Column="0" Text="FW Status:" FontAttributes="Bold"/>
                                        <Label Grid.Row="2" Grid.Column="1" Text="{Binding FirmwareUpdateStatus}" TextColor="{Binding FirmwareUpdateStatus, Converter={StaticResource FirmwareStatusColorConv}}"/>
                                    </Grid>

                                    <!-- Admin Actions -->
                                    <HorizontalStackLayout Spacing="10" Margin="0,10,0,0">
                                        <Button Text="Configure"
                                                CommandParameter="{Binding .}"
                                                Clicked="OnConfigureClicked"
                                                WidthRequest="120"/>
                                        <Button Text="Update Firmware"
                                                CommandParameter="{Binding .}"
                                                Clicked="OnUpdateFirmwareClicked"
                                                IsEnabled="{Binding Path=., Converter={StaticResource FirmwareUpdateNeededConverter}, ConverterParameter={Binding LatestFirmwareVersion}}"
                                                WidthRequest="150"/>
                                    </HorizontalStackLayout>

                                    <!-- Maintenance Actions (Moved inside Admin section or keep separate if needed) -->
                                    <HorizontalStackLayout Spacing="10" Margin="0,10,0,0">
                                        <Button Text="Schedule Maint."
                                                CommandParameter="{Binding .}"
                                                Clicked="OnScheduleMaintenanceClicked"
                                                WidthRequest="140"/>
                                        <Button Text="Mark Maint. Complete"
                                                CommandParameter="{Binding .}"
                                                Clicked="OnMarkMaintenanceCompleteClicked"
                                                IsEnabled="{Binding NextMaintenanceDate, Converter={StaticResource NullToBoolConverter False}}"
                                                WidthRequest="180"/>
                                    </HorizontalStackLayout>

                                </VerticalStackLayout>
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>