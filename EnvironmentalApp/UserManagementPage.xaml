<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="EnvironmentalApp.UserManagementPage"
             Title="UserManagementPage">
    <VerticalStackLayout Padding="20">
        <Label Text="Select User:" />
        <Picker x:Name="userPicker" ItemsSource="{Binding Users}" ItemDisplayBinding="{Binding Email}" />

        <Label Text="Select New Role:" Margin="0,20,0,0"/>
        <Picker x:Name="rolePicker">
            <Picker.Items>
                <x:String>admin</x:String>
                <x:String>user</x:String>
            </Picker.Items>
        </Picker>

        <Button Text="Update Role" Clicked="OnRoleChanged" Margin="0,20,0,0"/>
    </VerticalStackLayout>

</ContentPage>